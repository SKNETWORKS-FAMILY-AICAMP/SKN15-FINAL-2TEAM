# Triplan Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_DB=triplan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@triplan.com
DJANGO_SUPERUSER_PASSWORD=admin1234
ALLOWED_HOSTS=*

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
KAKAO_API_KEY=your_kakao_api_key_here
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_MAP_API_KEY=your_kakao_map_api_key_here
NEXT_PUBLIC_KAKAO_API_KEY=your_kakao_map_api_key_here

# Airflow Configuration
AIRFLOW_FERNET_KEY=your_airflow_fernet_key_here
AIRFLOW_WEBSERVER_SECRET_KEY=your_airflow_secret_key_here
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# Node Environment
NODE_ENV=development
