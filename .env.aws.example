# =============================================================================
# Triplan AWS Deployment Configuration
# =============================================================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp .env.aws.example .env
#
# 그리고 아래 IP 주소들을 실제 AWS 인스턴스 IP로 변경하세요.
# =============================================================================

# =============================================================================
# AWS 인스턴스 IP 주소 (여기를 수정하세요!)
# =============================================================================
# 1. Nginx 인스턴스
NGINX_PUBLIC_IP=YOUR_NGINX_PUBLIC_IP

# 2. Frontend 인스턴스
FRONTEND_PRIVATE_IP=172.31.X.X

# 3. Backend 인스턴스
BACKEND_PRIVATE_IP=172.31.X.X

# 4. WebSocket 인스턴스
WEBSOCKET_PRIVATE_IP=172.31.X.X

# 5. Redis 인스턴스
REDIS_PRIVATE_IP=172.31.X.X

# 6. PostgreSQL 인스턴스
POSTGRES_PRIVATE_IP=172.31.X.X

# 7. Airflow 인스턴스
AIRFLOW_PRIVATE_IP=172.31.X.X

# =============================================================================
# Django Settings
# =============================================================================
# ⚠️  Production 환경에서는 반드시 DEBUG=False로 설정하세요!
DEBUG=False

# ⚠️  새로운 SECRET_KEY를 생성하세요!
# Python 생성 명령어:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-temp-secret-key-for-development-only-change-in-production

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================
POSTGRES_DB=lecun2
POSTGRES_USER=postgres

# ⚠️  강력한 비밀번호로 변경하세요!
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD

# ⚠️  아래를 실제 PostgreSQL 인스턴스 Private IP로 변경하세요!
# 비밀번호에 특수문자가 있으면 URL 인코딩 필요: ! → %21, @ → %40, # → %23
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@172.31.X.X:5432/lecun2

# =============================================================================
# Redis (Cache and WebSocket Channel Layer)
# =============================================================================
# ⚠️  아래를 실제 Redis 인스턴스 Private IP로 변경하세요!
REDIS_URL=redis://172.31.X.X:6379/0

# =============================================================================
# OpenAI API
# =============================================================================
# ⚠️  실제 OpenAI API 키로 변경하세요!
OPENAI_API_KEY=sk-proj-YOUR-OPENAI-API-KEY-HERE
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# External APIs
# =============================================================================
# ⚠️  실제 Kakao API 키로 변경하세요!
KAKAO_API_KEY=YOUR_KAKAO_API_KEY
KAKAO_MAP_API_KEY=YOUR_KAKAO_MAP_API_KEY

# =============================================================================
# Frontend (NextJS) - 브라우저에서 접근하는 주소
# =============================================================================
NODE_ENV=production
    
# ⚠️  아래를 실제 Nginx 인스턴스 Public IP로 변경하세요!
# 브라우저가 Nginx로 요청을 보냅니다.
NEXT_PUBLIC_API_URL=http://YOUR_NGINX_PUBLIC_IP
NEXT_PUBLIC_WS_URL=ws://YOUR_NGINX_PUBLIC_IP
NEXT_PUBLIC_KAKAO_API_KEY=YOUR_KAKAO_API_KEY

# =============================================================================
# Nginx - 각 서비스로 프록시할 Private IP
# =============================================================================
# ⚠️  아래 IP들을 실제 각 서비스의 Private IP로 변경하세요!
FRONTEND_HOST=172.31.X.X
BACKEND_HOST=172.31.X.X
WEBSOCKET_HOST=172.31.X.X

# =============================================================================
# Airflow
# =============================================================================
# 기존 Fernet Key 유지 (데이터 암호화에 사용됨)
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=

# ⚠️  Production 환경에서는 새로운 Secret Key를 생성하세요!
# Python 생성 명령어:
#   python -c 'import secrets; print(secrets.token_hex(32))'
AIRFLOW_WEBSERVER_SECRET_KEY=airflow-secret-key-change-in-production

# Airflow 관리자 계정
AIRFLOW_USERNAME=admin

# ⚠️  강력한 비밀번호로 변경하세요!
AIRFLOW_PASSWORD=admin

# Airflow Postgres 비밀번호 (Airflow 전용 DB)
AIRFLOW_POSTGRES_PASSWORD=airflow

# =============================================================================
# Security & CORS
# =============================================================================
# ⚠️  아래를 실제 Nginx 인스턴스 Public IP로 변경하세요!
# 여러 호스트는 쉼표로 구분
ALLOWED_HOSTS=YOUR_NGINX_PUBLIC_IP,localhost

# ⚠️  아래를 실제 Nginx 인스턴스 Public IP로 변경하세요!
# localhost:3000은 로컬 테스트용 (Production에서는 제거 가능)
CORS_ALLOWED_ORIGINS=http://YOUR_NGINX_PUBLIC_IP,http://localhost:3000

# =============================================================================
# 배포 순서 및 체크리스트
# =============================================================================
#
# 1. 위의 모든 "XXX.XXX" IP 주소를 실제 AWS 인스턴스 IP로 변경
# 2. 모든 비밀번호와 Secret Key를 강력한 값으로 변경
# 3. 각 EC2 인스턴스에 이 .env 파일을 복사
# 4. deploy-instance.sh 실행하여 배포
#
# Private IP vs Public IP:
# - Private IP (172.31.x.x): AWS 내부 통신용 (DB, Redis, 서비스 간 통신)
# - Public IP (3.35.x.x): 외부 접근용 (브라우저 → Nginx)
#
# 필수 변경 항목:
# ✓ DEBUG=False
# ✓ SECRET_KEY (새로 생성)
# ✓ POSTGRES_PASSWORD (강력한 비밀번호)
# ✓ DATABASE_URL (PostgreSQL Private IP)
# ✓ REDIS_URL (Redis Private IP)
# ✓ NEXT_PUBLIC_API_URL (Nginx Public IP)
# ✓ NEXT_PUBLIC_WS_URL (Nginx Public IP)
# ✓ ALLOWED_HOSTS (Nginx Public IP)
# ✓ CORS_ALLOWED_ORIGINS (Nginx Public IP)
# ✓ FRONTEND_HOST (Frontend Private IP)
# ✓ BACKEND_HOST (Backend Private IP)
# ✓ WEBSOCKET_HOST (WebSocket Private IP)
# ✓ AIRFLOW_PASSWORD (강력한 비밀번호)
# ✓ OPENAI_API_KEY (실제 키)
# ✓ KAKAO_API_KEY (실제 키)
# =============================================================================
