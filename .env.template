# =============================================================================
# Triplan Environment Configuration Template
# =============================================================================
#
# 📋 사용법:
# 1. 이 파일을 복사하여 .env 파일 생성: cp .env.template .env
# 2. 아래 값들을 실제 값으로 변경
# 3. Git에는 .env 파일을 절대 올리지 마세요! (.gitignore에 포함됨)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# -----------------------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
POSTGRES_DB=lecun2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-here
DATABASE_URL=postgresql://postgres:your-postgres-password-here@postgres:5432/lecun2

# -----------------------------------------------------------------------------
# Redis (Cache and WebSocket Channel Layer)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# OpenAI API
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Chat Agent LLM Settings
CHAT_AGENT_MODEL=gpt-4-turbo-preview
CHAT_AGENT_TEMPERATURE=0.7

# STT (Speech-to-Text) Model Settings
STT_MODEL_PATH=./models/stt/model.safetensors

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# Kakao Map API (JavaScript Key)
# https://developers.kakao.com/console/app 에서 발급
KAKAO_API_KEY=your-kakao-api-key-here
KAKAO_MAP_API_KEY=your-kakao-api-key-here

# -----------------------------------------------------------------------------
# Frontend (NextJS)
# -----------------------------------------------------------------------------
# 빈 값 = 상대 경로 사용 (nginx 프록시를 통해 자동으로 처리, 모든 네트워크에서 작동)
# NEXT_PUBLIC_API_URL 및 NEXT_PUBLIC_WS_URL을 설정하지 않으면 자동으로 현재 호스트 사용
#NEXT_PUBLIC_API_URL=
#NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_KAKAO_API_KEY=your-kakao-api-key-here

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
AIRFLOW_FERNET_KEY=your-airflow-fernet-key-here
AIRFLOW_WEBSERVER_SECRET_KEY=airflow-secret-key-change-in-production
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# -----------------------------------------------------------------------------
# Security & CORS
# -----------------------------------------------------------------------------
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
