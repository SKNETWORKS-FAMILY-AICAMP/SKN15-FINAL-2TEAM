# ==========================================
# Triplan - Environment Variables
# ==========================================
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요
# cp .env.template .env

# ==========================================
# General Settings
# ==========================================
NODE_ENV=development
DEBUG=True

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_DB=triplan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/triplan

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://redis:6379/0

# ==========================================
# Django Backend
# ==========================================
SECRET_KEY=your-django-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# AI & External APIs
# ==========================================
# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Kakao Map API
KAKAO_API_KEY=your-kakao-api-key-here

# ==========================================
# Frontend (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_KAKAO_API_KEY=your-kakao-api-key-here

# ==========================================
# Airflow
# ==========================================
# Airflow Fernet Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=your-airflow-fernet-key-here

# Airflow Webserver Secret Key
AIRFLOW_WEBSERVER_SECRET_KEY=your-airflow-webserver-secret-key-here

# Airflow Admin Credentials
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# ==========================================
# Email Configuration (for notifications)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# ==========================================
# Monitoring & Logging
# ==========================================
# Sentry DSN (optional)
# SENTRY_DSN=your-sentry-dsn-here

# ==========================================
# Security (Production Only)
# ==========================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ==========================================
# 키 생성 방법
# ==========================================
# 1. Django Secret Key:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 2. Airflow Fernet Key:
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 3. Random Secret:
#    openssl rand -hex 32
